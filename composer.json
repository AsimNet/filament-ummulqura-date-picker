{
    "name": "asimnet/filament-ummulqura-date-picker",
    "description": "A Hijri (Umm al-Qura) date & time picker for Filament that shows both calendars while picking and stores whichever one you choose.",
    "keywords": [
        "filament",
        "filament-plugin",
        "hijri",
        "umm-al-qura",
        "calendar",
        "date-picker",
        "islamic",
        "saudi",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AsimNet/filament-ummulqura-date-picker",
    "support": {
        "issues": "https://github.com/AsimNet/filament-ummulqura-date-picker/issues",
        "source": "https://github.com/AsimNet/filament-ummulqura-date-picker"
    },
    "authors": [
        {
            "name": "AsimNet"
        }
    ],
    "require": {
        "php": "^8.2",
        "asimnet/ummulqura-calendar": "^1.0",
        "filament/forms": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AsimNet\\FilamentUmmulqura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimNet\\FilamentUmmulqura\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsimNet\\FilamentUmmulqura\\FilamentUmmulquraServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
